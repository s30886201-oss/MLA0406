# ---------------- 4. EXTRACT DATASET ----------------
import zipfile

zip_path = "/content/dataset_zip/plantvillage.zip"
extract_path = "/content/plantvillage_data"
os.makedirs(extract_path, exist_ok=True)

with zipfile.ZipFile(zip_path, 'r') as zip_ref:
    zip_ref.extractall(extract_path)
print("Dataset extracted successfully to:", extract_path)

def find_dataset_root(base_path):
    for root, dirs, files_ in os.walk(base_path):
        if len(dirs) > 1:
            sample_dir = os.path.join(root, dirs[0])
            sample_files = os.listdir(sample_dir)
            image_exts = (".jpg", ".jpeg", ".png", ".JPG", ".JPEG", ".PNG")
            if any(f.lower().endswith(image_exts) for f in sample_files):
                return root
    return base_path

DATASET_DIR = find_dataset_root(extract_path)
print("Detected dataset root directory:", DATASET_DIR)

# ---------------- 5. IMPORT LIBRARIES ----------------
import cv2
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import json
from PIL import Image

import tensorflow as tf
from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras.models import Sequential, load_model
from tensorflow.keras.layers import (
    Conv2D, MaxPooling2D, BatchNormalization,
    Dropout, Flatten, Dense
)
from tensorflow.keras.optimizers import Adam
from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint, ReduceLROnPlateau
from sklearn.metrics import classification_report, confusion_matrix

np.random.seed(42)
tf.random.set_seed(42)

print("TensorFlow version:", tf.__version__)
print("GPU available:", tf.config.list_physical_devices('GPU'))

# ---------------- 6. DATA PREPROCESSING ----------------
IMG_HEIGHT = 224
IMG_WIDTH = 224
IMG_SIZE = (IMG_HEIGHT, IMG_WIDTH)
BATCH_SIZE = 32
EPOCHS = 5              # REDUCED for fast demo
VALIDATION_SPLIT = 0.2
SEED = 42

print(f"Image Size: {IMG_SIZE}, Batch Size: {BATCH_SIZE}, Epochs: {EPOCHS}, Val Split: {VALIDATION_SPLIT}")

# ---------------- 7. DATA AUGMENTATION ----------------
train_datagen = ImageDataGenerator(
    rescale=1.0 / 255.0,
    rotation_range=25,
    width_shift_range=0.2,
    height_shift_range=0.2,
    shear_range=0.15,
    zoom_range=0.2,
    horizontal_flip=True,
    fill_mode="nearest",
    validation_split=VALIDATION_SPLIT
)

val_datagen = ImageDataGenerator(
    rescale=1.0 / 255.0,
    validation_split=VALIDATION_SPLIT
)
print("Data augmentation generators created successfully.")

# ---------------- 8. LOAD DATASET ----------------
train_generator = train_datagen.flow_from_directory(
    DATASET_DIR, target_size=IMG_SIZE, batch_size=BATCH_SIZE,
    class_mode="categorical", subset="training", shuffle=True, seed=SEED
)

validation_generator = val_datagen.flow_from_directory(
    DATASET_DIR, target_size=IMG_SIZE, batch_size=BATCH_SIZE,
    class_mode="categorical", subset="validation", shuffle=False, seed=SEED
)

class_labels = list(train_generator.class_indices.keys())
NUM_CLASSES = len(class_labels)

print("Detected Classes:")
for idx, label in enumerate(class_labels):
    print(f"  {idx}: {label}")
print(f"\nTotal Classes: {NUM_CLASSES}")
print(f"Training Images: {train_generator.samples}")
print(f"Validation Images: {validation_generator.samples}")

# ---------------- 9. DISPLAY SAMPLE IMAGES ----------------
sample_images, sample_labels = next(train_generator)

plt.figure(figsize=(12, 12))
for i in range(9):
    plt.subplot(3, 3, i + 1)
    plt.imshow(sample_images[i])
    label_index = np.argmax(sample_labels[i])
    plt.title(class_labels[label_index], fontsize=10)
    plt.axis("off")
plt.suptitle("Sample Training Images", fontsize=16)
plt.tight_layout()
plt.show()

# ---------------- 10. BUILD CNN MODEL ----------------
model = Sequential([
    Conv2D(32, (3, 3), activation="relu", padding="same", input_shape=(IMG_HEIGHT, IMG_WIDTH, 3)),
    BatchNormalization(),
    Conv2D(32, (3, 3), activation="relu", padding="same"),
    BatchNormalization(),
    MaxPooling2D(pool_size=(2, 2)),
    Dropout(0.25),

    Conv2D(64, (3, 3), activation="relu", padding="same"),
    BatchNormalization(),
    Conv2D(64, (3, 3), activation="relu", padding="same"),
    BatchNormalization(),
    MaxPooling2D(pool_size=(2, 2)),
    Dropout(0.25),

    Conv2D(128, (3, 3), activation="relu", padding="same"),
    BatchNormalization(),
    Conv2D(128, (3, 3), activation="relu", padding="same"),
    BatchNormalization(),
    MaxPooling2D(pool_size=(2, 2)),
    Dropout(0.3),

    Conv2D(256, (3, 3), activation="relu", padding="same"),
    BatchNormalization(),
    MaxPooling2D(pool_size=(2, 2)),
    Dropout(0.3),

    Flatten(),
    Dense(512, activation="relu"),
    BatchNormalization(),
    Dropout(0.5),
    Dense(256, activation="relu"),
    Dropout(0.4),

    Dense(NUM_CLASSES, activation="softmax")
])

model.summary()

# ---------------- 11. COMPILE MODEL ----------------
model.compile(
    optimizer=Adam(learning_rate=0.001),
    loss="categorical_crossentropy",
    metrics=["accuracy"]
)
print("Model compiled successfully.")

# ---------------- 12. TRAIN MODEL (FAST VERSION) ----------------
early_stop = EarlyStopping(monitor="val_loss", patience=5, restore_best_weights=True, verbose=1)
checkpoint = ModelCheckpoint(filepath="best_leaf_disease_model.keras", monitor="val_loss", save_best_only=True, verbose=1)
reduce_lr = ReduceLROnPlateau(monitor="val_loss", factor=0.5, patience=3, min_lr=1e-6, verbose=1)
callbacks_list = [early_stop, checkpoint, reduce_lr]

print("Callbacks configured: EarlyStopping, ModelCheckpoint, ReduceLROnPlateau")

history = model.fit(
    train_generator,
    steps_per_epoch=50,          # REDUCED — only ~1600 images per epoch instead of full dataset
    validation_data=validation_generator,
    validation_steps=20,         # REDUCED
    epochs=EPOCHS,
    callbacks=callbacks_list,
    verbose=1
)
print("Training complete.")

final_train_acc = history.history["accuracy"][-1] * 100
final_val_acc = history.history["val_accuracy"][-1] * 100
final_train_loss = history.history["loss"][-1]
final_val_loss = history.history["val_loss"][-1]

print(f"Final Training Accuracy:   {final_train_acc:.2f}%")
print(f"Final Validation Accuracy: {final_val_acc:.2f}%")
print(f"Final Training Loss:       {final_train_loss:.4f}")
print(f"Final Validation Loss:     {final_val_loss:.4f}")

# ---------------- 13. PLOT GRAPHS ----------------
acc = history.history["accuracy"]
val_acc = history.history["val_accuracy"]
loss = history.history["loss"]
val_loss = history.history["val_loss"]
epochs_range = range(1, len(acc) + 1)

plt.figure(figsize=(16, 6))

plt.subplot(1, 2, 1)
plt.plot(epochs_range, acc, label="Training Accuracy", marker="o", color="blue")
plt.plot(epochs_range, val_acc, label="Validation Accuracy", marker="o", color="orange")
plt.title("Training vs Validation Accuracy")
plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.legend()
plt.grid(True)

plt.subplot(1, 2, 2)
plt.plot(epochs_range, loss, label="Training Loss", marker="o", color="blue")
plt.plot(epochs_range, val_loss, label="Validation Loss", marker="o", color="orange")
plt.title("Training vs Validation Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()

# ---------------- 14. EVALUATE MODEL ----------------
val_loss_final, val_acc_final = model.evaluate(validation_generator, steps=20, verbose=1)
print(f"\nValidation (Test) Accuracy: {val_acc_final * 100:.2f}%")
print(f"Validation (Test) Loss: {val_loss_final:.4f}")

validation_generator.reset()
predictions = model.predict(validation_generator, steps=20, verbose=1)
predicted_classes = np.argmax(predictions, axis=1)
true_classes = validation_generator.classes[:len(predicted_classes)]

print("Classification Report:\n")
print(classification_report(true_classes, predicted_classes, target_names=class_labels, zero_division=0))

cm = confusion_matrix(true_classes, predicted_classes)
plt.figure(figsize=(14, 12))
sns.heatmap(cm, annot=False, fmt="d", cmap="Blues", xticklabels=class_labels, yticklabels=class_labels)
plt.title("Confusion Matrix")
plt.xlabel("Predicted Label")
plt.ylabel("True Label")
plt.xticks(rotation=90)
plt.yticks(rotation=0)
plt.tight_layout()
plt.show()

# ---------------- 15. SAVE MODEL ----------------
model.save("leaf_disease_model.keras")
print("Model saved as 'leaf_disease_model.keras'")

with open("class_labels.json", "w") as f:
    json.dump(class_labels, f)
print("Class labels saved as 'class_labels.json'")

# ---------------- 16. LOAD SAVED MODEL ----------------
loaded_model = load_model("leaf_disease_model.keras")
with open("class_labels.json", "r") as f:
    loaded_class_labels = json.load(f)

print("Model reloaded successfully.")
print("Number of classes loaded:", len(loaded_class_labels))

# ---------------- 17. UPLOAD LEAF IMAGE ----------------
print("Please upload a leaf image (jpg/png):")
uploaded_image = files.upload()
uploaded_filename = list(uploaded_image.keys())[0]
print(f"\nUploaded file: {uploaded_filename}")

# ---------------- 18. PREDICT DISEASE ----------------
def preprocess_uploaded_image(image_path, target_size=(IMG_HEIGHT, IMG_WIDTH)):
    img = Image.open(image_path).convert("RGB")
    img = img.resize(target_size)
    img_array = np.array(img) / 255.0
    img_array = np.expand_dims(img_array, axis=0)
    return img, img_array

display_img, processed_img = preprocess_uploaded_image(uploaded_filename)
prediction_probs = loaded_model.predict(processed_img)[0]

top_index = np.argmax(prediction_probs)
top_confidence = prediction_probs[top_index] * 100
predicted_label = loaded_class_labels[top_index]

if "healthy" in predicted_label.lower():
    status = "Healthy"
    display_name = "Healthy Leaf"
else:
    status = "Diseased"
    display_name = predicted_label.replace("___", " - ").replace("_", " ")

print("Prediction Results")
print("-------------------")
print(f"Prediction:  {display_name}")
print(f"Confidence:  {top_confidence:.2f}%")
print(f"Status:      {status}")

# ---------------- 19. DISPLAY RESULTS ----------------
plt.figure(figsize=(6, 6))
plt.imshow(display_img)
plt.axis("off")
plt.title(f"Prediction: {display_name}\nConfidence: {top_confidence:.2f}% | Status: {status}",
          fontsize=12, color="darkgreen" if status == "Healthy" else "darkred")
plt.show()

top5_indices = np.argsort(prediction_probs)[::-1][:5]
top5_labels = [loaded_class_labels[i].replace("___", " - ").replace("_", " ") for i in top5_indices]
top5_probs = [prediction_probs[i] * 100 for i in top5_indices]

print("Top 5 Predicted Classes:")
for label, prob in zip(top5_labels, top5_probs):
    print(f"  {label}: {prob:.2f}%")

plt.figure(figsize=(10, 6))
bars = plt.barh(top5_labels[::-1], top5_probs[::-1], color="mediumseagreen")
plt.xlabel("Confidence (%)")
plt.title("Top 5 Predicted Classes - Probability Chart")
plt.xlim(0, 100)
for bar, prob in zip(bars, top5_probs[::-1]):
    plt.text(bar.get_width() + 1, bar.get_y() + bar.get_height() / 2, f"{prob:.2f}%", va="center", fontsize=10)
plt.tight_layout()
plt.show()

